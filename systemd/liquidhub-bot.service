[Unit]
Description=LiquidhubIndicatorSystem — paper trading orchestrator
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=adas
WorkingDirectory=%h/LiquidhubIndicatorSystem/src
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/uv run liquidhub run
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
