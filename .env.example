LIQUIDHUB_ENV=dev

DATABASE_URL=postgresql+psycopg://liquidhub:liquidhub@localhost:5432/liquidhub
REDIS_URL=redis://localhost:6379/0

EXCHANGE=bitget
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT,DOGE/USDT:USDT
TIMEFRAMES=5m,15m,1h,4h

VOTE_MIN_CONFIDENCE=0.60
VOTE_MIN_CONSENSUS=0.30
WORKER_AGREEMENT_MIN=7

ENABLE_FUTURES_SHORT=true
MAX_LEVERAGE=5.0

ENABLE_HOUR_FILTER=true
BLACKLIST_HOURS_UTC=5,9,10,22

PAPER_CAPITAL=10000
TICK_INTERVAL_SECONDS=900

MODELS_DIR=../models
LOG_LEVEL=INFO

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
